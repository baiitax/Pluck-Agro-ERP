# ---------------------------------------------------------------------------
# Pluck Agro ERP — environment template
# Copy to .env.local and fill in values. Never commit real credentials.
# ---------------------------------------------------------------------------

# Public application URL (used for auth email redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key. Safe for the browser, but RLS still enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. NEVER expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# development | test | production
NODE_ENV=development

# Optional: project ref used by `npm run db:types`
SUPABASE_PROJECT_REF=
